<?xml version="1.0" encoding="utf-8" ?>
<elements>
  <info>
    <name>UA2026 - Villainous Options</name>
    <description>Four subclasses from Unearthed Arcana 2026 Villainous Options.</description>
    <author url="http://dnd.wizards.com/articles/features">Wizards of the Coast</author>
    <update version="0.0.1">
      <file name="UA2026-VillainousOptions.xml" url="local/UA2026-VillainousOptions.xml" />
    </update>
  </info>

  <!-- Cleric: Pestilence Domain -->
  <element name="Pestilence Domain" type="Archetype" source="UA2026 Villainous Options" id="ID_WOTC_UA2026_CLERIC_PESTILENCE_DOMAIN">
    <supports>Cleric</supports>
    <description><p>Clerics of the Pestilence Domain harness supernatural plague and decay to erode their enemies' vitality.</p></description>
    <rules>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_CLERIC_PESTILENCE_BLIGHT_WEAVER" level="3"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_CLERIC_PESTILENCE_SPELLS" level="3"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_CLERIC_PESTILENCE_PLAGUE_BLESSING" level="3"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_CLERIC_PESTILENCE_VIRULENT_BURST" level="6"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_CLERIC_PESTILENCE_VERMIN_FORM" level="17"/>
    </rules>
  </element>

  <!-- Druid: Circle of the Titan -->
  <element name="Circle of the Titan" type="Archetype" source="UA2026 Villainous Options" id="ID_WOTC_UA2026_DRUID_TITAN">
    <supports>Druid</supports>
    <description><p>Druids of the Circle of the Titan assume towering monstrous forms to mete out cataclysmic retribution.</p></description>
    <rules>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_DRUID_TITAN_SPELLS" level="3"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_DRUID_TITAN_FORM" level="3"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_DRUID_TITAN_DIRE_IMPACT" level="6"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_DRUID_TITAN_PRIMAL_HAVOC" level="10"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_DRUID_TITAN_MONSTROUS_APPETITE" level="14"/>
    </rules>
  </element>

  <!-- Fighter: Hell Knight -->
  <element name="Hell Knight" type="Archetype" source="UA2026 Villainous Options" id="ID_WOTC_UA2026_FIGHTER_HELLKNIGHT">
    <supports>Fighter</supports>
    <description><p>Hell Knights are champions of archdevils, armed with infernal powers and hellfire weapons.</p></description>
    <rules>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_FIGHTER_HELLKNIGHT_DIABOLICAL_GIFT" level="3"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_FIGHTER_HELLKNIGHT_HELLFIRE_WEAPON" level="3"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_FIGHTER_HELLKNIGHT_INFERNAL_WOUND" level="3"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_FIGHTER_HELLKNIGHT_ADVANCED_WOUNDS" level="7"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_FIGHTER_HELLKNIGHT_HELLFORGED_EQUIPMENT" level="7"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_FIGHTER_HELLKNIGHT_HELLFIRE_SURGE" level="10"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_FIGHTER_HELLKNIGHT_BLISTER_AVERNUS" level="15"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_FIGHTER_HELLKNIGHT_CONDEMNATION" level="18"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_FIGHTER_HELLKNIGHT_BARGAIN" level="18"/>
    </rules>
  </element>

  <!-- Sorcerer: Demonic Sorcery -->
  <element name="Demonic Sorcery" type="Archetype" source="UA2026 Villainous Options" id="ID_WOTC_UA2026_SORCERER_DEMONIC_SORCERY">
    <supports>Sorcerer</supports>
    <description><p>The corruptive magic of demons courses through you, warping your body and surroundings.</p></description>
    <rules>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_SORCERER_DEMONIC_RUPTURE" level="3"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_SORCERER_DEMONIC_SPELLS" level="3"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_SORCERER_ABYSSAL_AURA" level="6"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_SORCERER_ABYSSAL_CONDUIT" level="14"/>
      <grant type="Archetype Feature" id="ID_WOTC_UA2026_SORCERER_FIENDISH_SERVANT" level="18"/>
    </rules>
  </element>
</elements>
